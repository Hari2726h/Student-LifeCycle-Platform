# Local Postgres (docker compose up -d)
DATABASE_URL="postgresql://maatram:maatram_dev_password@localhost:5432/maatram_student_lifecycle?schema=public"

# NextAuth — after copying this file to .env, generate a real secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and paste the output here. Don't use a placeholder shorter than 32
# characters: lib/aadhaar.ts falls back to AUTH_SECRET for Aadhaar hashing
# and refuses to start below that length.
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Optional stable HMAC key for Aadhaar duplicate detection. If omitted,
# AUTH_SECRET is used. Never store the full Aadhaar number in the database.
AADHAAR_HMAC_SECRET=""

# File storage — S3-compatible (S3Mock locally via docker compose up -d;
# swap the endpoint/credentials for real S3/MinIO in production, the code
# that talks to it is unchanged)
S3_ENDPOINT="http://localhost:9090"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="test"
S3_SECRET_ACCESS_KEY="test"
S3_BUCKET="maatram-documents"

# Optional — enables the two AI-assisted features (alumni Q&A, committee
# advisory summaries). Leave unset and both degrade to a plain setup
# message; nothing else in the app depends on this. Get a key at
# https://aistudio.google.com/apikey — put it ONLY here, never in chat.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
